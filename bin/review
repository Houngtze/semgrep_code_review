#!/bin/bash
set -e
PROJ=$1
if [ -z "$PROJ" ]; then 
  echo "Usage: review <project-path> [base-branch] [target-branch]"
  echo "  Example: review ./my-project master develop"
  exit 1
fi

cd "$(dirname "$0")/.."
cd runner
if [ ! -d node_modules ]; then
  echo "Installing runner deps..."
  npm install
fi

node index.js "$@"
